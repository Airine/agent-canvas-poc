# Copy to .env.e and edit; dev:e/start:e load it automatically. No credentials here.
ADE_ROOT=/absolute/path/to/ADE
# PI_BIN=pi
# CANVAS_PROJECT_ROOT=/absolute/path/to/your/project
# CANVAS_DATA_DIR=/absolute/path/to/persistent/canvas-data
API_PORT=3300
CANVAS_UI_PORT=5173

# Native card assets are acquired/built separately; see native/README.md.

    "@radix-ui/react-switch": "^1.2.6",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "react-router": "^7.6.1",
    "remark-gfm": "4.0.1",
    "shiki": "3.22.0",
    "sonner": "^2.0.7",

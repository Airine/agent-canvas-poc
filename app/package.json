    "start": "node dist-api/index.js",
    "dev:e": "node scripts/dev-e.mjs",
    "test": "node --import tsx --test test/unit/*.test.mjs",
    "collaboration:inspect": "node scripts/collaboration-inspect.mjs",
    "test:e2e": "playwright test",
    "start:e": "node scripts/dev-e.mjs --production"
  },
